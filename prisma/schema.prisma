generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model custom_categories {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  icon      String?
  isCustom  Boolean? @default(true)
  createdAt DateTime @default(now())
}

model custom_products {
  id            String   @id @default(uuid())
  name          String
  brand         String?
  category      String
  categoryLabel String?
  weight        String?
  price         Float
  mrp           Float?
  unit          String?
  availability  String?
  badge         String?
  image         String?
  description   String?
  createdAt     DateTime @default(now())
}

model edited_overrides {
  id          String   @id
  name        String?
  price       Float?
  mrp         Float?
  weight      String?
  description String?
  badge       String?
  updatedAt   DateTime @default(now()) @updatedAt
}
